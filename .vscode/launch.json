{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main_api:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "env": {
        "RAG_DEBUG": "true" 
      },
      "jinja": true,
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}